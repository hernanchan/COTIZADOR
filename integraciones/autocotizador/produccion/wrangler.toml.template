# DOCUMENTOS PRODUCCIÓN aislado: NO publicar ni abrir pagos.
# La Central LIVE no requiere URL pública gracias al service binding.
# Para cotizar/recibir documentos reales se necesitarán bindings separados
# de D1 tarifaria, R2, Supabase, seguridad, Turnstile y sesiones productivas.
name = "saber-documentos-produccion"
main = "../recepcion/dist/saber-documentos-cotizador-fase4.mjs"
compatibility_date = "2026-10-17"
workers_dev = false
preview_urls = false
keep_vars = false

[vars]
SABER_ENTORNO = "preparacion"
CENTRAL_DB_ENV = "produccion"
DOCS_MP_LIVE_GATE = "NO_GO"
CENTRAL_LIVE_URL = "https://pagos.libreriasaber.com.ar/internal/central/live/checkout"

[[services]]
binding = "SABER_CENTRAL"
service = "saber-pagos-produccion"
